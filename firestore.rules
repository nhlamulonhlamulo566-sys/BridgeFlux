rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Development mode: Allow wide-open access for prototyping
    // This resolves potential "Permission Denied" errors during session setup
    // Access is scoped in the application code via userId (Session Token)
    
    match /tunnels/{tunnelId} {
      allow read, write: if true;
    }
    
    match /domains/{domainId} {
      allow read, write: if true;
    }
    
    match /security_rules/{ruleId} {
      allow read, write: if true;
    }
    
    match /traffic_logs/{logId} {
      allow read, write: if true;
    }
    
    match /{document=**} {
      allow read, write: if true;
    }
  }
}